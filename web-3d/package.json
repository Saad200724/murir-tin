{
  "name": "murir-tin-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Murir Tin 3D - Dhaka Local Bus Chapani & Traffic Chaos WebGL Game",
  "type": "module",
  "scripts": {
    "generate:models": "node scripts/generate-dhaka-glb.mjs",
    "dev": "vite --port 5174",
