    "test": "vitest run",
    "package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@types/three": "^0.175.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  }
}
